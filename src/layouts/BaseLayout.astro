---
import SiteMenu from '../components/SiteMenu.astro';
import Footer from '../components/Footer.astro';
const title = Astro.props.title ?? 'Asiantte';
const description = Astro.props.description ?? 'Asiantte — Asian Beauty, Unapologetically.';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Manrope:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <SiteMenu />
    <slot />
    <Footer />
  </body>
</html>
