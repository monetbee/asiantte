---
import type { CollectionEntry } from 'astro:content';
import SiteMenu from '../components/SiteMenu.astro';
import Footer from '../components/Footer.astro';
import "../styles/global.css";

type Props = CollectionEntry<'pandoraBlog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, category, tags } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdatedDate = updatedDate ? updatedDate.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}) : null;
---
<!doctype html>
<html class="page-theme blog-post-theme" lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title} — Asiantteブログ</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <SiteMenu />
  <main class="page-main blog-post-main">
    <a href="/Asiantte blog/blog" class="back-link">← ブログ一覧へ戻る</a>

    <p class="eyebrow">{category ? category : 'ASIANTTE JOURNAL'}</p>
    <h1>{title}</h1>

    <div class="post-meta">
      <p class="post-date">{formattedDate}</p>
      {
        formattedUpdatedDate && <p class="post-updated">（更新日: {formattedUpdatedDate}）</p>
      }
    </div>

    {
      heroImage && (
        <div class="hero-image">
          <img src={heroImage} alt="" width={1020} height={510} />
        </div>
      )
    }

    <div class="prose">
      <slot />
    </div>

    {
      tags && tags.length > 0 && (
        <div class="tags-wrap">
          <p class="tags-label">タグ</p>
          <ul class="tags">
            {tags.map((tag) => <li>{tag}</li>)}
          </ul>
        </div>
      )
    }
  </main>
  <Footer />
</body>
</html>

<style>
  .blog-post-main {
    max-width: 780px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2.5rem;
    color: #b08d57;
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: opacity 180ms ease;
  }

  .back-link:hover {
    opacity: 0.75;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    margin: 0 0 2rem;
  }

  .post-date {
    margin: 0;
    color: #b08d57;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
  }

  .post-updated {
    margin: 0;
    color: #6f6a63;
    font-size: 0.78rem;
  }

  .hero-image {
    margin: 0 0 3rem;
  }

  .hero-image img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0;
    filter: saturate(0.85) contrast(1.05);
  }

  .prose {
    color: #d8d4ce;
    font-size: 1rem;
    line-height: 2;
  }

  .prose h2 {
    margin-top: 3.5rem;
    color: #f4efe8;
    font-family: "Cormorant Garamond", serif;
    font-weight: 500;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    line-height: 1.2;
  }

  .prose p {
    margin: 1.2rem 0 2rem;
    color: #c5c0b9;
  }

  .prose strong {
    color: #f4efe8;
    font-weight: 600;
  }

  .prose ul {
    padding-left: 1.4rem;
    color: #c5c0b9;
    line-height: 2;
  }

  .prose li {
    margin: 0.5rem 0;
  }

  .tags-wrap {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(216, 212, 206, 0.12);
  }

  .tags-label {
    margin: 0 0 0.8rem;
    color: #6f6a63;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tags li {
    margin: 0;
    padding: 0.45rem 0.9rem;
    border: 1px solid rgba(176, 141, 87, 0.45);
    border-radius: 999px;
    color: #d8d4ce;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    line-height: 1.4;
  }
</style>