---
import SiteMenu from "../../components/SiteMenu.astro";
import Footer from "../../components/Footer.astro";
import { categoryProducts } from "../../data/site-products";

export function getStaticPaths() {
  return Object.keys(categoryProducts).map((category) => ({ params: { category } }));
}

const labels: Record<string, [string, string]> = {
  gift: ["ギフト", "大切な人に贈る、Asiantteのジュエリー"],
  rings: ["リング", "静かな存在感を添えるリング"],
  earrings: ["ピアス", "耳元に光と余白をつくるピアス"],
  bracelets: ["ブレスレット", "自分のリズムで揺れるブレスレット"],
  necklaces: ["ネックレス", "首元に美しい余白をつくるネックレス"],
};
const key = Astro.params.category || "gift";
const [title, description] = labels[key] || ["Category", "Asiantte jewelry"];
const products = categoryProducts[key] || [];
---
<!doctype html>
<html lang="ja">
  <head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title} — Asiantte</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet"/></head>
  <body><SiteMenu /><main><p class="eyebrow">FASHION JEWELRY</p><h1>{title}</h1><p class="intro">{description}</p><div class="products">{products.map((product, index) => <article class="product"><div class="placeholder"><span>{String(index + 1).padStart(2, "0")}</span><small>PHOTO COMING SOON</small></div><div><p class="category">{product.category}</p><h2>{product.name}</h2><p class="description">{product.description}</p><strong>{product.price}</strong><p class="made-in">制作国：日本</p></div></article>)}</div></main><Footer /></body>
</html>
<style>
:global(*){box-sizing:border-box}:global(body){margin:0;background:#fff;color:#171717;font-family:Manrope,"Noto Sans JP",sans-serif}main{max-width:1200px;margin:auto;padding:10vw 6vw}.eyebrow,.category{color:#9a753e;font-size:.65rem;letter-spacing:.15em}.eyebrow{margin:0}h1{font:500 clamp(4rem,10vw,8rem) "Cormorant Garamond",serif;margin:1rem 0}.intro{max-width:36rem;color:#666;line-height:1.8}.products{display:grid;grid-template-columns:repeat(3,1fr);gap:3rem 1.5rem;margin-top:6rem}.product{display:flex;flex-direction:column;gap:1rem}.placeholder{display:flex;min-height:20rem;flex-direction:column;justify-content:space-between;padding:1.2rem;background:#eeece8;color:#9a753e}.product:nth-child(2n) .placeholder{background:#e8eeed}.placeholder span{font:500 4rem "Cormorant Garamond",serif}.placeholder small{font-size:.58rem;letter-spacing:.14em}.product h2{margin:.5rem 0;font:500 2rem "Cormorant Garamond",serif}.category{margin:0}.description{color:#666;font-size:.78rem;line-height:1.7}.product strong{font-size:.78rem;font-weight:500}.made-in{color:#888;font-size:.65rem}@media(max-width:800px){.products{grid-template-columns:repeat(2,1fr)}}@media(max-width:520px){.products{grid-template-columns:1fr}}
</style>