---
export function getStaticPaths() {
  return ["gift", "rings", "earrings", "bracelets", "necklaces"].map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const labels = { gift: ["ギフト", "大切な人に贈る、Asiantteのジュエリー"], rings: ["リング", "静かな存在感を添えるリング"], earrings: ["ピアス", "The Drop — A mark of presence."], bracelets: ["ブレスレット", "自分のリズムで揺れるブレスレット"], necklaces: ["ネックレス", "首元に美しい余白をつくるネックレス"] };
const [title, description] = labels[category] || ["Category", "Asiantte jewelry"];
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title} — Asiantte</title><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet"/></head><body><header><a class="logo" href="/">Asiantte</a><a href="/categories">All categories</a></header><main><p class="eyebrow">CATEGORY</p><h1>{title}</h1><p class="intro">{description}</p><div class="empty">Products from this category will appear here.<br/><span>Coming soon.</span></div></main></body></html>
<style>:global(*){box-sizing:border-box}:global(body){margin:0;background:#fff;color:#171717;font-family:Manrope,"Noto Sans JP",sans-serif}header{display:flex;justify-content:space-between;padding:2rem 6vw;border-bottom:1px solid #17171720}header a{font-size:.7rem;letter-spacing:.1em;text-decoration:none}.logo{font-family:"Cormorant Garamond",serif;font-size:1.6rem}main{max-width:1100px;margin:auto;padding:10vw 6vw}.eyebrow{color:#9a753e;font-size:.65rem;letter-spacing:.15em}h1{font:500 clamp(4rem,10vw,8rem) "Cormorant Garamond",serif;margin:1rem 0}.intro{color:#666;line-height:1.8}.empty{margin-top:7rem;padding:4rem;border:1px solid #17171720;color:#666;line-height:2}.empty span{color:#9a753e;font-size:.7rem;letter-spacing:.12em}
</style>
