---
const categories = [
  ["ギフト", "/categories/gift", "大切な人に贈るジュエリー"],
  ["リング", "/categories/rings", "静かな存在感を添えるリング"],
  ["ピアス", "/categories/earrings", "The Drop — A mark of presence."],
  ["ブレスレット", "/categories/bracelets", "自分のリズムで揺れるブレスレット"],
  ["ネックレス", "/categories/necklaces", "首元に美しい余白をつくるネックレス"],
];
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>Categories — Asiantte</title><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet"/></head><body><header><a class="logo" href="/">Asiantte</a><a href="/collection">Collection</a></header><main><p class="eyebrow">EXPLORE</p><h1>Categories</h1><div class="grid">{categories.map(([name, href, text]) => <a href={href}><h2>{name}</h2><p>{text}</p><span>Explore →</span></a>)}</div></main><footer>Asiantte</footer></body></html>
<style>:global(*){box-sizing:border-box}:global(body){margin:0;background:#fff;color:#171717;font-family:Manrope,"Noto Sans JP",sans-serif}header{display:flex;justify-content:space-between;padding:2rem 6vw;border-bottom:1px solid #17171720}header a{font-size:.7rem;letter-spacing:.1em;text-decoration:none}.logo{font-family:"Cormorant Garamond",serif;font-size:1.6rem}main{max-width:1100px;margin:auto;padding:9vw 6vw}.eyebrow{color:#9a753e;font-size:.65rem;letter-spacing:.15em}h1{font:500 clamp(4rem,10vw,8rem) "Cormorant Garamond",serif;margin:1rem 0 5rem}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:#17171730}.grid a{min-height:14rem;padding:2rem;background:#fff;text-decoration:none;transition:background .2s,color .2s}.grid a:hover{background:#171717;color:#fff}.grid h2{font:500 2.4rem "Cormorant Garamond",serif;margin:0 0 .75rem}.grid p{color:#666;font-size:.8rem}.grid span{display:block;margin-top:3rem;font-size:.65rem;letter-spacing:.12em}.grid a:hover p{color:#ccc}footer{padding:2rem 6vw;border-top:1px solid #17171720;font-size:.7rem}@media(max-width:650px){.grid{grid-template-columns:1fr}}
</style>
