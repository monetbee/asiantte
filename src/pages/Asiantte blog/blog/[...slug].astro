---
import { getCollection, type CollectionEntry, render } from 'astro:content';
import Asiantteblogpost from '../../../layouts/Asiantteblogpost.astro';

export async function getStaticPaths() {
  const posts = await getCollection('pandoraBlog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<'pandoraBlog'>;

const post = Astro.props;
const { Content } = await render(post);
---

<Asiantteblogpost {...post.data}>
  <Content />
</Asiantteblogpost>
