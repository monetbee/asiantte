---
import "../../styles/global.css";
import SiteMenu from "../../components/SiteMenu.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("pandoraBlog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const title = "Asiantte — ブログ — Asian Beauty Journal";
const description =
  "アジアの美しさの文化、伝統工芸、美意識を探求するAsiantteのジャーナル。";
---

<!doctype html>
<html class="page-theme blog-theme" lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Manrope:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <SiteMenu />
    <main class="page-main blog-main">
      <p class="eyebrow">ASIANTTE JOURNAL</p>
      <h1>ブログ</h1>
      <p class="lead">
        アジアに息づく美しさの文化、伝統工芸、美意識について。Asiantteの視点から、多様なアジアの美を探求します。
      </p>

      <section class="featured-post">
        {
          posts[0] && (
            <a href={`/Asiantte blog/blog/${posts[0].id}/`} class="featured-link">
              {
                posts[0].data.heroImage && (
                  <div class="featured-image">
                    <img src={posts[0].data.heroImage} alt="" />
                  </div>
                )
              }
              <div class="featured-content">
                <p class="featured-label">FEATURED</p>
                <h2>{posts[0].data.title}</h2>
                <p class="featured-date">
                  {posts[0].data.pubDate.toLocaleDateString("ja-JP", { year: "numeric", month: "long", day: "numeric" })}
                </p>
                <p class="featured-desc">{posts[0].data.description}</p>
                <span class="read-more">記事を読む →</span>
              </div>
            </a>
          )
        }
      </section>

      <section class="post-grid">
        {
          posts.slice(1).map((post) => (
            <a href={`/Asiantte blog/blog/${post.id}/`} class="post-card">
              {
                post.data.heroImage && (
                  <div class="post-image">
                    <img src={post.data.heroImage} alt="" loading="lazy" />
                  </div>
                )
              }
              <div class="post-content">
                <p class="post-date">
                  {post.data.pubDate.toLocaleDateString("ja-JP", { year: "numeric", month: "long", day: "numeric" })}
                </p>
                <h3>{post.data.title}</h3>
                <p class="post-desc">{post.data.description}</p>
                <span class="read-more">記事を読む →</span>
              </div>
            </a>
          ))
        }
      </section>

      <div class="note blog-note">
        新着記事は随時更新中です。アジアの美しさについて、もっと知りたい方は
        <a href="/about" class="blog-note-link">Asiantteについて</a>もご覧ください。
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  .blog-main {
    max-width: 1080px;
  }

  .blog-main .lead {
    max-width: 44rem;
  }

  .featured-post {
    margin-top: clamp(3.5rem, 6vw, 5rem);
  }

  .featured-link {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2.5rem;
    align-items: center;
    color: inherit;
    text-decoration: none;
    border: 1px solid rgba(176, 141, 87, 0.35);
    background: rgba(255, 255, 255, 0.02);
    transition: border-color 220ms ease, background 220ms ease;
  }

  .featured-link:hover {
    border-color: rgba(176, 141, 87, 0.7);
    background: rgba(176, 141, 87, 0.05);
  }

  .featured-image {
    overflow: hidden;
    height: 100%;
    min-height: 18rem;
  }

  .featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    filter: saturate(0.85) contrast(1.05);
    transition: transform 500ms ease;
  }

  .featured-link:hover .featured-image img {
    transform: scale(1.03);
  }

  .featured-content {
    padding: 2rem 2.5rem 2rem 0;
  }

  .featured-label {
    margin: 0 0 1rem;
    color: #b08d57;
    font-size: 0.68rem;
    letter-spacing: 0.22em;
  }

  .featured-content h2 {
    margin: 0 0 1rem;
    color: #f4efe8;
    font-family: "Cormorant Garamond", serif;
    font-weight: 500;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
  }

  .featured-date {
    margin: 0 0 1.2rem;
    color: #6f6a63;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
  }

  .featured-desc {
    margin: 0 0 1.5rem;
    color: #c5c0b9;
    font-size: 0.95rem;
    line-height: 1.9;
  }

  .read-more {
    display: inline-block;
    color: #b08d57;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.06em;
  }

  .featured-link:hover .read-more,
  .post-card:hover .read-more {
    opacity: 0.75;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: clamp(3rem, 5vw, 4rem);
  }

  .post-card {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
    border: 1px solid rgba(216, 212, 206, 0.12);
    background: rgba(255, 255, 255, 0.02);
    transition: border-color 220ms ease, background 220ms ease;
  }

  .post-card:hover {
    border-color: rgba(176, 141, 87, 0.6);
    background: rgba(176, 141, 87, 0.04);
  }

  .post-image {
    overflow: hidden;
  }

  .post-image img {
    width: 100%;
    height: 12rem;
    object-fit: cover;
    border-radius: 0;
    filter: saturate(0.85) contrast(1.05);
    transition: transform 500ms ease;
  }

  .post-card:hover .post-image img {
    transform: scale(1.03);
  }

  .post-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.6rem 1.8rem 1.8rem;
  }

  .post-date {
    margin: 0 0 0.8rem;
    color: #6f6a63;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
  }

  .post-content h3 {
    margin: 0 0 0.8rem;
    color: #f4efe8;
    font-family: "Cormorant Garamond", serif;
    font-weight: 500;
    font-size: 1.5rem;
    line-height: 1.15;
  }

  .post-desc {
    margin: 0 0 1.2rem;
    color: #c5c0b9;
    font-size: 0.88rem;
    line-height: 1.85;
    flex: 1;
  }

  .blog-note {
    max-width: 44rem;
  }

  .blog-note-link {
    color: inherit;
    text-decoration: underline;
  }

  @media (max-width: 820px) {
    .featured-link {
      grid-template-columns: 1fr;
    }

    .featured-image {
      min-height: 14rem;
    }

    .featured-content {
      padding: 0 1.8rem 1.8rem;
    }

    .post-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .post-image img {
      height: 10rem;
    }
  }
</style>