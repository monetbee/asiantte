---
import SiteMenu from "../components/SiteMenu.astro";
import { newArrivals } from "../data/site-products";
---
<!doctype html>
<html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>New Arrivals — Asiantte</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet"/></head><body><SiteMenu /><main><p class="eyebrow">NEW ARRIVALS</p><h1>新作</h1><p class="lead">2026年秋、MIZUHAとSENから届いた最新のアイテム。</p><div class="grid">{newArrivals.map((product, index) => <article><div class="placeholder"><span>{String(index + 1).padStart(2, "0")}</span><small>NEW SEASON · PHOTO COMING SOON</small></div><p class="category">{product.category}</p><h2>{product.name}</h2><p class="description">{product.description}</p><strong>{product.price}</strong><p class="made-in">制作国：日本</p></article>)}</div><a class="button" href="/collection">コレクションを見る →</a></main><footer>Asiantte</footer></body></html>
<style>
:global(*){box-sizing:border-box}:global(body){margin:0;background:#fff;color:#171717;font-family:Manrope,"Noto Sans JP",sans-serif}main{max-width:1200px;margin:auto;padding:10vw 6vw}.eyebrow,.category{color:#9a753e;font-size:.65rem;letter-spacing:.15em}.eyebrow{margin:0}h1{font:500 clamp(4rem,10vw,8rem) "Cormorant Garamond",serif;margin:1rem 0}.lead{color:#666;line-height:1.8}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem;margin-top:5rem}.placeholder{display:flex;min-height:22rem;flex-direction:column;justify-content:space-between;padding:1.2rem;background:#e8eeed;color:#607a7b}.grid article:nth-child(2n) .placeholder{background:#eee9e2;color:#92785d}.placeholder span{font:500 4rem "Cormorant Garamond",serif}.placeholder small{font-size:.55rem;letter-spacing:.1em}.category{margin:1.2rem 0 .4rem}.grid h2{margin:0;font:500 1.8rem "Cormorant Garamond",serif}.description{color:#666;font-size:.75rem;line-height:1.7}.grid strong{font-size:.75rem;font-weight:500}.made-in{color:#888;font-size:.62rem}.button{display:inline-block;margin-top:5rem;padding:1rem 1.5rem;border:1px solid #9a753e;color:#171717;text-decoration:none;font-size:.7rem;letter-spacing:.1em}.button:hover{background:#9a753e;color:#fff}footer{padding:2rem 6vw;border-top:1px solid #17171720;font-size:.7rem}@media(max-width:900px){.grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:520px){.grid{grid-template-columns:1fr}}
</style>
