---
const products = [
  { name: "The Drop", category: "Earrings", price: "¥18,700", image: "/images/products/drop.jpg", href: "/products/the-drop", line: "A mark of presence." },
  { name: "The Wave", category: "Earrings", price: "¥19,800", image: "/images/products/wave.webp", href: "/products/the-wave", line: "Move with your own rhythm." },
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
    <title>Collection — Asiantte</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header><a class="wordmark" href="/">Asiantte</a><a class="back" href="/">Back to home</a></header>
    <main><p class="eyebrow">THE FIRST COLLECTION</p><h1>Objects of presence.</h1><p class="intro">アジアの美しさと、身につける人の個性を讃えるファーストコレクション。</p>
      <div class="grid">{products.map((product, index) => <a class="card" href={product.href}><div class="image"><img src={product.image} alt={product.name} /></div><div class="meta"><span>0{index + 1} / {product.category}</span><h2>{product.name}</h2><p>{product.line}</p><strong>{product.price}</strong><small>View product →</small></div></a>)}</div>
    </main>
    <footer>Asiantte <span>Asian Beauty, Unapologetically.</span></footer>
  </body>
</html>
<style>
  :global(*){box-sizing:border-box}:global(body){margin:0;background:#fff;color:#171717;font-family:"Manrope","Noto Sans JP",sans-serif}:global(a){color:inherit}header{display:flex;justify-content:space-between;align-items:center;padding:2rem clamp(1.25rem,5vw,5rem);border-bottom:1px solid #17171718}.wordmark{font-family:"Cormorant Garamond",serif;font-size:1.6rem;text-decoration:none;letter-spacing:.08em}.back{font-size:.68rem;letter-spacing:.12em;text-decoration:none;text-transform:uppercase}main{max-width:1280px;margin:auto;padding:clamp(4rem,10vw,9rem) clamp(1.25rem,5vw,5rem)}.eyebrow{color:#9a753e;font-size:.65rem;letter-spacing:.18em}h1{margin:1rem 0;font-family:"Cormorant Garamond",serif;font-size:clamp(3rem,8vw,7rem);font-weight:500;line-height:.9}.intro{max-width:28rem;color:#666;line-height:1.9}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:clamp(1.5rem,5vw,5rem);margin-top:clamp(4rem,9vw,8rem)}.card{text-decoration:none}.image{aspect-ratio:1/1.15;overflow:hidden;background:#f3f1ee}.image img{width:100%;height:100%;object-fit:cover;transition:transform .5s ease}.card:hover .image img{transform:scale(1.04)}.meta{padding:1.25rem 0}.meta span{color:#9a753e;font-size:.62rem;letter-spacing:.14em;text-transform:uppercase}.meta h2{margin:.8rem 0 .2rem;font-family:"Cormorant Garamond",serif;font-size:2.1rem;font-weight:500}.meta p{margin:0 0 1rem;color:#666;font-size:.8rem}.meta strong{font-size:.75rem;font-weight:500}.meta small{display:block;margin-top:1.25rem;font-size:.65rem;letter-spacing:.12em;text-transform:uppercase;opacity:0;transform:translateY(.4rem);transition:.2s}.card:hover small{opacity:1;transform:none}footer{display:flex;justify-content:space-between;padding:2rem clamp(1.25rem,5vw,5rem);border-top:1px solid #17171718;font-size:.7rem;letter-spacing:.1em}footer span{color:#888}@media(max-width:700px){.grid{grid-template-columns:1fr}footer{display:block}footer span{display:block;margin-top:.5rem}}
</style>
