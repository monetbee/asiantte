---
import SiteMenu from "../components/SiteMenu.astro";
import { autumn2026Collections, autumn2026Products } from "../data/autumn-2026";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>2026 Autumn Collection — Asiantte</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <SiteMenu />
    <main>
      <header class="intro">
        <p class="eyebrow">AUTUMN 2026</p>
        <h1>Autumn, in motion.</h1>
        <p>雫の光と、しなやかな線。二つのテーマで描く2026年秋のコレクション。</p>
      </header>

      {autumn2026Collections.map((collection) => {
        const products = autumn2026Products.filter((product) => product.collectionId === collection.id);
        return (
          <section class:list={["collection", collection.id]} aria-labelledby={`${collection.id}-title`}>
            <div class="collection-heading">
              <p class="eyebrow">{collection.japaneseName} / AUTUMN 2026</p>
              <h2 id={`${collection.id}-title`}>{collection.name}</h2>
              <p class="concept">{collection.concept}</p>
              <p>{collection.description}</p>
              <span>10 variations · Made in Japan</span>
            </div>
            <div class="grid">
              {products.map((product, index) => (
                <a class="card" href={`/products/${product.slug}`}>
                  <div class="image-placeholder" aria-label={`${product.name}の写真は準備中`}>
                    <span>{collection.name}</span><small>PHOTO COMING SOON</small>
                  </div>
                  <div class="meta">
                    <span>{String(index + 1).padStart(2, "0")} / {product.category}</span>
                    <h3>{product.name}</h3>
                    <p>{product.description}</p>
                    <strong>{product.price}</strong>
                    <small>製品を見る →</small>
                  </div>
                </a>
              ))}
            </div>
          </section>
        );
      })}
    </main>
    <footer>Asiantte <span>Asian Beauty, Unapologetically.</span></footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #fff; color: #171717; font-family: Manrope, "Noto Sans JP", sans-serif; }
  main { max-width: 1400px; margin: auto; padding: 8rem 6vw 10rem; }
  .intro { max-width: 48rem; margin-bottom: 10rem; }
  .eyebrow { margin: 0; color: #9a753e; font-size: .65rem; letter-spacing: .18em; }
  h1, h2, h3 { font-family: "Cormorant Garamond", serif; font-weight: 500; }
  h1 { margin: 1rem 0 2rem; font-size: clamp(4rem, 10vw, 8rem); line-height: .85; }
  .intro > p:last-child, .collection-heading > p:not(.eyebrow):not(.concept) { color: #666; line-height: 1.9; }
  .collection { margin-top: 10rem; }
  .collection-heading { max-width: 38rem; }
  h2 { margin: .6rem 0; font-size: clamp(3.5rem, 8vw, 6.5rem); line-height: .9; }
  .concept { margin: 1.5rem 0 .6rem; font-size: 1.05rem; letter-spacing: .04em; }
  .collection-heading span { display: block; margin-top: 2rem; color: #9a753e; font-size: .68rem; letter-spacing: .14em; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3.5rem 2rem; margin-top: 4rem; }
  .card { color: inherit; text-decoration: none; }
  .image-placeholder { display: flex; flex-direction: column; justify-content: flex-end; min-height: clamp(18rem, 35vw, 32rem); padding: 1.5rem; background: #eeece8; color: #827b73; transition: background .3s ease; }
  .mizuha .image-placeholder { background: #e8eeed; color: #607a7b; }
  .sen .image-placeholder { background: #eee9e2; color: #92785d; }
  .image-placeholder span { font: 500 clamp(2rem, 5vw, 4rem) "Cormorant Garamond", serif; letter-spacing: .08em; }
  .image-placeholder small { margin-top: .35rem; font-size: .6rem; letter-spacing: .14em; }
  .card:hover .image-placeholder { background: #ded8cf; }
  .meta { padding: 1.2rem 0; }
  .meta > span, .meta small { color: #9a753e; font-size: .62rem; letter-spacing: .14em; }
  .meta h3 { margin: .7rem 0 .25rem; font-size: 2.1rem; }
  .meta p { max-width: 32rem; margin: 0; color: #666; font-size: .8rem; line-height: 1.8; }
  .meta strong { display: block; margin-top: 1rem; font-size: .75rem; font-weight: 500; }
  .meta small { display: block; margin-top: 1.2rem; opacity: 0; transition: opacity .2s ease; }
  .card:hover small { opacity: 1; }
  footer { display: flex; justify-content: space-between; padding: 2rem 6vw; border-top: 1px solid #17171718; font-size: .7rem; letter-spacing: .1em; }
  footer span { color: #888; }
  @media (max-width: 650px) { main { padding-top: 5rem; } .intro, .collection { margin-bottom: 6rem; } .collection { margin-top: 7rem; } .grid { grid-template-columns: 1fr; gap: 2.5rem; } footer { display: block; } footer span { display: block; margin-top: .5rem; } }
</style>
