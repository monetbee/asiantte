---
import SiteMenu from "../components/SiteMenu.astro";
const products = [{name:"The Drop",category:"Earrings",price:"¥18,700",image:"/images/products/drop.jpg",href:"/products/the-drop",line:"A mark of presence."},{name:"The Wave",category:"Earrings",price:"¥19,800",image:"/images/products/wave.webp",href:"/products/the-wave",line:"Move with your own rhythm."}];
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>Collection — Asiantte</title><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet"/></head><body><SiteMenu /><main><p class="eyebrow">THE FIRST COLLECTION</p><h1>Objects of presence.</h1><p class="intro">アジアの美しさと、身につける人の個性を讃えるファーストコレクション。</p><div class="grid">{products.map((p,i)=><a class="card" href={p.href}><div class="image"><img src={p.image} alt={p.name}/></div><div class="meta"><span>0{i+1} / {p.category}</span><h2>{p.name}</h2><p>{p.line}</p><strong>{p.price}</strong><small>View product →</small></div></a>)}</div></main><footer>Asiantte <span>Asian Beauty, Unapologetically.</span></footer></body></html><style>:global(*){box-sizing:border-box}:global(body){margin:0;background:#fff;color:#171717;font-family:Manrope,"Noto Sans JP",sans-serif}header{display:flex;justify-content:space-between;padding:2rem 6vw;border-bottom:1px solid #17171718}header a{font-size:.7rem;letter-spacing:.1em;text-decoration:none}.logo{font-family:"Cormorant Garamond",serif;font-size:1.6rem}main{max-width:1280px;margin:auto;padding:9vw 6vw}.eyebrow{color:#9a753e;font-size:.65rem;letter-spacing:.18em}h1{font:500 clamp(4rem,10vw,8rem) "Cormorant Garamond",serif;line-height:.85;margin:1rem 0}.intro{max-width:30rem;color:#666;line-height:1.9}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:4rem;margin-top:8rem}.card{text-decoration:none}.image{aspect-ratio:1/1.1;overflow:hidden;background:#f3f1ee}.image img{width:100%;height:100%;object-fit:cover;transition:transform .5s}.card:hover img{transform:scale(1.04)}.meta{padding:1.2rem 0}.meta span{color:#9a753e;font-size:.62rem;letter-spacing:.14em}.meta h2{font:500 2.2rem "Cormorant Garamond",serif;margin:.7rem 0 .2rem}.meta p{color:#666;font-size:.8rem}.meta strong{font-size:.75rem;font-weight:500}.meta small{display:block;margin-top:1.2rem;font-size:.65rem;letter-spacing:.12em;opacity:0}.card:hover small{opacity:1}footer{display:flex;justify-content:space-between;padding:2rem 6vw;border-top:1px solid #17171718;font-size:.7rem}footer span{color:#888}@media(max-width:650px){.grid{grid-template-columns:1fr}footer{display:block}}
</style>
