import SiteMenu from "../components/SiteMenu.astro";
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>Founding Access — Asiantte</title><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet"/></head><body><SiteMenu /><main><p class="eyebrow">FOUNDING ACCESS</p><h1>Be there<br/>from the beginning.</h1><p>First Collectionの先行情報と予約開始のお知らせを、いち早くお届けします。</p><form><input type="email" placeholder="Your email address" required/><button type="submit">Join Founding Access</button></form><p class="fine">登録いただいた情報は、Asiantteからのお知らせのみに使用します。</p></main></body></html><style>:global(*){box-sizing:border-box}:global(body){margin:0;background:#111;color:#fff;font-family:Manrope,"Noto Sans JP",sans-serif}header{display:flex;justify-content:space-between;padding:2rem 6vw}header a{color:inherit;font-size:.7rem;letter-spacing:.1em;text-decoration:none}.logo{font-family:"Cormorant Garamond",serif;font-size:1.6rem}main{max-width:900px;margin:auto;padding:12vw 6vw}.eyebrow{color:#b08d57;font-size:.65rem;letter-spacing:.15em}h1{font:500 clamp(4rem,10vw,8rem) "Cormorant Garamond",serif;line-height:.82;margin:1rem 0 2rem}main>p:not(.eyebrow){max-width:32rem;color:#ccc;line-height:1.8}form{display:flex;gap:.7rem;margin-top:4rem}input,button{padding:1.1rem 1.2rem;border:1px solid #b08d57;background:transparent;color:#fff;font:inherit}input{flex:1}button{background:#b08d57;color:#111;cursor:pointer}.fine{font-size:.65rem;color:#777!important}@media(max-width:600px){form{display:block}input,button{width:100%;margin-bottom:.7rem}}
</style>
