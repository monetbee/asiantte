---
import SiteMenu from "../components/SiteMenu.astro";
import Footer from "../components/Footer.astro";
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>Contact — Asiantte</title><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet"/></head><body><SiteMenu /><main><p class="eyebrow">CONTACT</p><h1>We would love<br/>to hear from you.</h1><p class="intro">商品、ギフト、コラボレーションに関するお問い合わせを承ります。</p><form><label>Name<input type="text" required/></label><label>Email<input type="email" required/></label><label>Message<textarea rows="6" required></textarea></label><button type="submit">Send inquiry</button></form></main><Footer /></body></html><style>:global(*){box-sizing:border-box}:global(body){margin:0;background:#fff;color:#171717;font-family:Manrope,"Noto Sans JP",sans-serif}header{display:flex;justify-content:space-between;padding:2rem 6vw;border-bottom:1px solid #17171720}header a{font-size:.7rem;letter-spacing:.1em;text-decoration:none}.logo{font-family:"Cormorant Garamond",serif;font-size:1.6rem}main{max-width:850px;margin:auto;padding:10vw 6vw}.eyebrow{color:#9a753e;font-size:.65rem;letter-spacing:.15em}h1{font:500 clamp(4rem,9vw,8rem) "Cormorant Garamond",serif;line-height:.82;margin:1rem 0 2rem}.intro{color:#666;line-height:1.8}form{display:grid;gap:1.2rem;margin-top:5rem}label{display:grid;gap:.5rem;color:#666;font-size:.7rem;letter-spacing:.08em}input,textarea,button{padding:1rem;border:1px solid #17171740;background:#fff;color:#171717;font:inherit}button{background:#171717;color:#fff;cursor:pointer;letter-spacing:.1em}
</style>