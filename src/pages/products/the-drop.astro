---
import Footer from "../../components/Footer.astro";

const product = {
  name: "The Drop",
  category: "Fashion Jewelry / Earrings",
  price: "¥18,700",
  image: "/images/products/drop.jpg",
  description: "耳元に静かな存在感を添える、Asiantteのシグネチャーピアス。日常の装いから特別な夜まで、身につける人のリズムに寄り添います。",
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{product.name} — Asiantte</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/">Asiantte</a>
      <a class="back-link" href="/collection">Back to collection</a>
    </header>

    <main class="product-page">
      <div class="product-image-wrap">
        <img src={product.image} alt={product.name} />
      </div>
      <section class="product-info" aria-labelledby="product-title">
        <p class="eyebrow">{product.category}</p>
        <h1 id="product-title">{product.name}</h1>
        <p class="price">{product.price}</p>
        <p class="description">{product.description}</p>
        <dl class="details">
          <div><dt>Material</dt><dd>Gold-plated brass</dd></div>
          <div><dt>制作国</dt><dd>日本</dd></div>
          <div><dt>Dimensions</dt><dd>Approx. 35 mm</dd></div>
          <div><dt>Delivery</dt><dd>Ships within 3–5 business days</dd></div>
        </dl>
        <button class="add-button" type="button">Add to cart</button>
        <div class="review-summary" aria-label="レビュー評価 5つ星中4.8">
          <span class="stars">★★★★★</span><strong>4.8</strong><span class="review-count">12 reviews</span>
        </div>
        <button class="review-button" type="button">レビューを書く</button>
        <section class="shipping-note"><h2>Wrapping</h2><p>Asiantteシグネチャー付きのショッパーとジュエリーケースにお包みしてお届けします。</p></section>
        <p class="note">Free shipping on orders over ¥30,000. Duties and taxes are calculated at checkout.</p>
        <div class="product-actions">
          <button class="detail-button" type="button" aria-expanded="false">Product details +</button>
          <div class="detail-panel" hidden>
            <h2>Details</h2>
            <p>素材、取り扱い方法、配送に関する大切な情報をご確認いただけます。</p>
            <h3>Material & care</h3><p>Gold-plated brass。水分、香水、化粧品との長時間の接触を避け、使用後は柔らかい布で拭いて保管してください。</p>
            <h3>注意事項</h3><p>一点ずつ仕上げているため、色味や表情に個体差があります。画面上の色と実物が異なる場合があります。</p>
            <h3>返品ポリシー</h3><p>未使用品に限り、商品到着後7日以内にご連絡ください。ピアスなど衛生上の理由により、開封後の返品はお受けできません。</p>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<script>
  const detailButton = document.querySelector('.detail-button');
  const detailPanel = document.querySelector('.detail-panel');
  detailButton?.addEventListener('click', () => {
    const isOpen = detailButton.getAttribute('aria-expanded') === 'true';
    detailButton.setAttribute('aria-expanded', String(!isOpen));
    detailButton.textContent = isOpen ? 'Product details +' : 'Product details −';
    if (detailPanel) detailPanel.hidden = isOpen;
  });
</script>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #ffffff; color: #171717; font-family: "Manrope", "Noto Sans JP", sans-serif; }
  :global(a) { color: inherit; }
  .site-header { display: flex; justify-content: space-between; align-items: center; padding: 2rem clamp(1.25rem, 5vw, 5rem); }
  .wordmark { font-family: "Cormorant Garamond", serif; font-size: 1.6rem; text-decoration: none; letter-spacing: 0.08em; }
  .back-link { font-size: 0.7rem; letter-spacing: 0.1em; text-decoration: none; text-transform: uppercase; opacity: 0.8; }
  .product-page { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.9fr); gap: clamp(2rem, 8vw, 8rem); align-items: center; max-width: 1300px; min-height: calc(100vh - 7rem); margin: auto; padding: 3rem clamp(1.25rem, 5vw, 5rem) 7rem; }
  .product-image-wrap { aspect-ratio: 1 / 1.08; overflow: hidden; background: #f3f1ee; }
  .product-image-wrap img { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.8); }
  .product-info { max-width:  thirtyrem; }
  .eyebrow { color: #b08d57; font-size: 0.65rem; letter-spacing: 0.16em; text-transform: uppercase; }
  h1 { margin: 1rem 0 0.5rem; font-family: "Cormorant Garamond", serif; font-size: clamp(3rem, 7vw, 6rem); font-weight: 500; line-height: 0.9; }
  .price { margin: 1.5rem 0 2rem; font-size: 0.9rem; letter-spacing: 0.08em; }
  .description { max-width: 30rem; color: #555; line-height: 1.9; }
  .details { margin: 2.5rem 0; border-top: 1px solid #17171738; }
  .details div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.85rem 0; border-bottom: 1px solid #1717171f; font-size: 0.72rem; }
  dt { color: #777; } dd { margin: 0; text-align: right; }
  .add-button { width: 100%; padding: 1.1rem; border: 1px solid #b08d57; background: #b08d57; color: #111111; font: inherit; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; cursor: pointer; transition: background 180ms ease, color 180ms ease; }
  .add-button:hover { background: transparent; color: #171717; }
  .review-summary { display: flex; align-items: center; gap: 0.7rem; margin-top: 1.75rem; font-size: 0.75rem; }
  .stars { color: #b08d57; letter-spacing: 0.1em; }
  .review-count { color: #777; font-size: 0.65rem; }
  .review-button { margin-top: 0.8rem; border: 0; border-bottom: 1px solid #171717; padding: 0 0 0.25rem; background: transparent; color: #171717; font: inherit; font-size: 0.68rem; cursor: pointer; }
  .shipping-note { margin-top: 2rem; padding: 1.25rem 0; border-top: 1px solid #17171724; border-bottom: 1px solid #17171724; }
  .shipping-note h2 { margin: 0 0 0.35rem; font-family: "Cormorant Garamond", serif; font-size: 1.35rem; font-weight: 500; }
  .shipping-note p { margin: 0; color: #555; font-size: 0.72rem; line-height: 1.8; }
  .note { color: #777; font-size: 0.65rem; line-height: 1.6; }
  .product-actions { margin-top: 1.5rem; }
  .detail-button { border: 0; padding: 0; background: transparent; color: #171717; font: inherit; font-size: 0.7rem; letter-spacing: 0.1em; cursor: pointer; }
  .detail-panel { margin-top: 1.25rem; padding-top: 1.25rem; border-top: 1px solid #17171724; color: #555; font-size: 0.75rem; line-height: 1.8; }
  .detail-panel h2, .detail-panel h3 { color: #171717; font-family: "Cormorant Garamond", serif; font-weight: 500; }
  .detail-panel h2 { margin: 0 0 0.5rem; font-size: 1.8rem; }
  .detail-panel h3 { margin: 1.25rem 0 0.15rem; font-size: 1.25rem; }
  .detail-panel p { margin: 0; }
  @media (max-width: 760px) { .product-page { grid-template-columns: 1fr; min-height: auto; padding-top: 1rem; } .product-info { padding-bottom: 2rem; } }
</style>
