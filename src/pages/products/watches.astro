---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = "Asiantte Watch Collection — 時計｜Asiantte";
---

<BaseLayout title={title}>
  <section class="product-hero">
    <div class="hero-media">
      <img src="/images/products/watch-hero.jpg" alt="Asiantte Royal Green Watch — フロントビュー" />
    </div>
    <div class="product-summary">
      <p class="eyebrow">FINE WATCHES</p>
      <h1>Asiantte Royal — グリーンダイアル</h1>
      <p class="price">¥798,000</p>
      <p class="lead">クラシックな意匠を現代的に仕立てたAsiantteの機械式ウォッチ。グリーンのサンバーストダイアルと刻みのベゼルが特徴です。</p>
      <p><a class="cta" href="/contact">ご購入・お問い合わせ</a></p>
    </div>
  </section>

  <section class="gallery" aria-label="時計の詳細写真ギャラリー">
    <div class="product-image-wrap">
      <figure>
        <img src="/images/products/watches/watch_gldgrn.jpeg" alt="Asiantte Royal — グリーンのサンバーストダイアル" onerror="this.onerror=null;this.src='/images/products/drop.jpg'" />
      </figure>
      <figure>
        <img src="/images/products/watches/watch_gldgrn_02.jpeg" alt="Asiantte Royal — 正面 / ケースとダイアル" onerror="this.onerror=null;this.src='/images/products/drop.jpg'" />
      </figure>
      <figure>
        <img src="/images/products/watches/watch_gldgrn_wear_03.jpeg" alt="Asiantte Royal — 手首着用の全体像" onerror="this.onerror=null;this.src='/images/products/drop.jpg'" />
      </figure>
      <figure>
        <img src="/images/products/watches/watch01_frontwhple.jpeg" alt="Asiantte Royal — 正面から見たケースの細部" onerror="this.onerror=null;this.src='/images/products/drop.jpg'" />
      </figure>
      <figure>
        <img src="/images/products/watches/watch01_side.jpeg" alt="Asiantte Royal — サイドビューと厚み感" onerror="this.onerror=null;this.src='/images/products/drop.jpg'" />
      </figure>
    </div>
  </section>

  <section class="specs">
    <h2>仕様</h2>
    <dl>
      <div><dt>ムーブメント</dt><dd>自動巻き（NH35相当）</dd></div>
      <div><dt>ケース素材</dt><dd>316L ステンレススチール（ゴールドPVD）</dd></div>
      <div><dt>ケース径</dt><dd>36mm</dd></div>
      <div><dt>防水</dt><dd>100m</dd></div>
      <div><dt>風防</dt><dd>サファイアクリスタル</dd></div>
      <div><dt>ブレス</dt><dd>5連ジュビリーブレス（クイックリリース）</dd></div>
      <div><dt>限定</dt><dd>限定300本（シリアル刻印入り）</dd></div>
    </dl>
  </section>

  <section class="description">
    <h2>商品説明</h2>
    <p>Asiantte Royalは、伝統的なドレスウォッチのコードを受け継ぎつつ、都会的な仕上げを施した一品です。ダイアルはサンバースト仕上げで光の角度により表情を変えます。日常使いに適した堅牢性と、オーナーシップを感じさせる細部の作り込みを両立しました。</p>
  </section>

  <style>
    :global(body){ margin:0; background: #ffffff; color: #171717; font-family: "Manrope", "Noto Sans JP", sans-serif; }
    .product-hero{ display:flex; gap:3rem; align-items:center; padding:6rem 6vw; max-width:1200px; margin:auto; }
    .hero-media img{ width:420px; max-width:38vw; border-radius:6px; box-shadow:0 1.5rem 3.5rem rgba(0,0,0,.06); }
    .product-summary{ max-width:46ch; color:#171717; }
    .eyebrow{ color:#8f6f3e; letter-spacing:.14em; font-size:.75rem; margin:0 0 .8rem; }
    h1{ font-family: 'Cormorant Garamond', serif; margin:.2rem 0 1rem; font-size:2.8rem; }
    .price{ color:#6b5840; font-weight:600; margin-bottom:1rem; }
    .lead{ color:#4a4a4a; line-height:1.8; }
    .cta{ display:inline-block; margin-top:1.2rem; background:#b08d57; color:#fff; padding:.7rem 1.1rem; text-decoration:none; border-radius:6px; }
    .gallery{ max-width:1200px; margin:2rem auto; padding:0 6vw; }
    .product-image-wrap{ display:grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap:1rem; }
    .product-image-wrap figure{ margin:0; }
    .gallery img{ width:100%; height:100%; max-height:360px; object-fit:cover; border-radius:6px; box-shadow:0 .6rem 2rem rgba(0,0,0,.06); }
    .specs{ max-width:720px; margin:3rem auto; padding:0 6vw; color:#4a4a4a; }
    .specs h2{ font-family:'Cormorant Garamond', serif; color:#171717; }
    dl div{ display:flex; justify-content:space-between; padding:.6rem 0; border-bottom:1px solid rgba(23,23,23,.06); }
    dt{ color:#777; } dd{ margin:0; }
    .description{ max-width:920px; margin:2rem auto 6rem; padding:0 6vw; color:#4a4a4a; line-height:1.8; }
    @media (max-width:800px){ .product-hero{ flex-direction:column; padding:3.5rem 6vw; } .hero-media img{ width:86vw; max-width:none; } .product-image-wrap{ grid-template-columns:1fr; } }
  </style>
</BaseLayout>
