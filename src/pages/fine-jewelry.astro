---
import SiteMenu from "../components/SiteMenu.astro";

const masterpieces = [
  { number: "01", name: "MIZUHA Imperial Cascade", category: "High Jewelry Earrings", price: "¥12,800,000", detail: "雫の連なりを、ダイヤモンドとプラチナで描いた一点制作のイヤリング。", stone: "Diamond · Platinum 950" },
  { number: "02", name: "SEN Eternal Line", category: "High Jewelry Necklace", price: "¥18,500,000", detail: "身体の動きに合わせて光が流れる、しなやかなダイヤモンドネックレス。", stone: "Diamond · 18K Yellow Gold" },
  { number: "03", name: "MIZUHA Moonlit Ring", category: "High Jewelry Ring", price: "¥9,600,000", detail: "水面に浮かぶ月の光を思わせる、希少なカラーレスダイヤモンドのリング。", stone: "Diamond · Platinum 950" },
  { number: "04", name: "SEN Silken Bracelet", category: "High Jewelry Bracelet", price: "¥14,200,000", detail: "なめらかな曲線を重ね、手首に光の軌跡を残すブレスレット。", stone: "Diamond · 18K Yellow Gold" },
  { number: "05", name: "MIZUHA First Light", category: "High Jewelry Pendant", price: "¥7,800,000", detail: "最初の一滴が光をとらえる瞬間を表現した、ダイヤモンドペンダント。", stone: "Diamond · Platinum 950" },
  { number: "06", name: "SEN Horizon Earrings", category: "High Jewelry Earrings", price: "¥11,400,000", detail: "静かな水平線のように、凛とした余白をつくるドロップイヤリング。", stone: "Diamond · 18K White Gold" },
  { number: "07", name: "MIZUHA Celestial Parure", category: "One-of-a-Kind High Jewelry Set", price: "¥48,000,000", detail: "希少なダイヤモンドを雫の連なりとして仕立てた、ネックレスとイヤリングの特別なパリュール。", stone: "Exceptional Diamond · Platinum 950" },
  { number: "08", name: "SEN Imperial Serpent", category: "High Jewelry Necklace", price: "¥62,000,000", detail: "しなやかな曲線を描くボディに、厳選したダイヤモンドを連ねたアトリエ最高峰のネックレス。", stone: "Diamond · Platinum 950 · 18K Gold" },
  { number: "09", name: "MIZUHA One Hundred Drops", category: "High Jewelry Tiara", price: "¥85,000,000", detail: "百の雫が光を受けて揺らめく、王冠のための一点制作。特別なセレモニーに合わせて仕立てます。", stone: "Rare Diamond · Platinum 950" },
  { number: "10", name: "SEN Legacy Collection", category: "Museum-Grade High Jewelry Suite", price: "¥120,000,000", detail: "世代を超えて受け継ぐことを前提に、最上級の石と日本の職人技を結集したフルセット。", stone: "Exceptional Diamond · Platinum 950 · 18K Gold" },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Fine Jewelry — Asiantte</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <SiteMenu />
    <main>
      <header class="intro">
        <p class="eyebrow">HAUTE JOAILLERIE</p>
        <h1>Fine Jewelry</h1>
        <p class="lead">希少な素材、卓越した技術、そして時間を超える美しさ。一点ずつ、日本の職人が仕立てるAsiantteのハイジュエリーです。</p>
        <p><a class="category-link" href="/products/watches">時計コレクションを見る →</a></p>
      </header>

      <section class="statement">
        <p class="eyebrow">THE ATELIER COLLECTION</p>
        <h2>Made for a lifetime.<br />Made only for you.</h2>
        <p>すべて受注制作。石選びから最終仕上げまで、あなたのためだけに完成させます。</p>
      </section>

      <section class="lineup" aria-labelledby="lineup-title">
        <div class="lineup-heading">
          <div>
            <p class="eyebrow">PRIVATE COLLECTION</p>
            <h2 id="lineup-title">Masterpieces</h2>
          </div>
          <span>Prices include tax · Made in Japan · By private appointment</span>
        </div>
        <p class="luxury-note">The Asiantte Reserve — 希少石と一点制作で仕立てる、最高峰のプライベートライン。</p>
        <div class="grid">
          {masterpieces.map((product) => (
            <article class="card">
              <div class="image-placeholder">
                <span>{product.number}</span>
                <small>PRIVATE VIEWING ONLY</small>
              </div>
              <div class="card-content">
                <p>{product.category}</p>
                <h3>{product.name}</h3>
                <strong>{product.price}</strong>
                <p class="detail">{product.detail}</p>
                <dl><div><dt>素材</dt><dd>{product.stone}</dd></div><div><dt>制作国</dt><dd>日本</dd></div></dl>
                <a href="/contact">プライベートビューイングを予約する →</a>
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>
    <footer><span>Asiantte</span><span>Asian Beauty, Unapologetically.</span></footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #10100f; color: #f5f0e8; font-family: Manrope, "Noto Sans JP", sans-serif; }
  main { max-width: 1440px; margin: auto; padding: 8rem 6vw 10rem; }
  .intro { max-width: 50rem; min-height: 64vh; display: grid; align-content: center; }
  .eyebrow { margin: 0; color: #b08d57; font-size: .64rem; letter-spacing: .18em; }
  h1, h2, h3 { font-family: "Cormorant Garamond", serif; font-weight: 500; }
  h1 { margin: 1rem 0 2rem; font-size: clamp(4.5rem, 12vw, 10rem); line-height: .8; letter-spacing: -.035em; }
  .lead { max-width: 37rem; color: #c8c1b7; line-height: 2; }
  .statement { max-width: 45rem; margin: 8rem 0 11rem; }
  .statement h2 { margin: 1rem 0 2rem; font-size: clamp(3rem, 7vw, 6.5rem); line-height: .88; }
  .statement > p:last-child { color: #c8c1b7; line-height: 1.9; }
  .lineup-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid rgba(245,240,232,.25); }
  .lineup-heading h2 { margin: .6rem 0 0; font-size: clamp(3rem, 6vw, 5rem); line-height: .85; }
  .lineup-heading span { color: #b08d57; font-size: .62rem; letter-spacing: .1em; }
  .luxury-note { margin: 1.5rem 0 -1rem; color: #e3c98e; font-family: "Cormorant Garamond", serif; font-size: 1.25rem; letter-spacing: .04em; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6rem 2rem; margin-top: 4rem; }
  .image-placeholder { display: flex; min-height: clamp(22rem, 39vw, 38rem); flex-direction: column; justify-content: space-between; padding: 1.5rem; background: radial-gradient(circle at 65% 30%, #5e4d32, #201e1a 62%, #111); border: 1px solid rgba(176,141,87,.38); }
  .card:nth-child(even) .image-placeholder { background: radial-gradient(circle at 35% 70%, #5b513c, #1d1d19 62%, #111); }
  .card:nth-child(n+7) .image-placeholder { min-height: clamp(24rem, 42vw, 41rem); background: radial-gradient(circle at 50% 35%, #80663d, #2b251c 58%, #111); border-color: rgba(227,201,142,.65); box-shadow: inset 0 0 5rem rgba(227,201,142,.08), 0 1rem 3rem rgba(0,0,0,.22); }
  .card:nth-child(n+7) .image-placeholder span { color: #f0d99f; }
  .card:nth-child(n+7) h3 { color: #f0d99f; }
  .card:nth-child(n+7) strong { font-size: 1rem; }
  .image-placeholder span { color: #d6ba85; font: 500 clamp(4rem, 10vw, 8rem) "Cormorant Garamond", serif; line-height: .7; }
  .image-placeholder small { color: #e4d5b7; font-size: .58rem; letter-spacing: .18em; }
  .card-content { padding-top: 1.4rem; }
  .card-content > p:first-child { margin: 0; color: #b08d57; font-size: .61rem; letter-spacing: .14em; }
  h3 { margin: .7rem 0; font-size: clamp(2rem, 4vw, 3.5rem); line-height: .95; }
  strong { display: block; color: #e3c98e; font-size: .9rem; font-weight: 500; letter-spacing: .06em; }
  .detail { max-width: 30rem; color: #c8c1b7; font-size: .8rem; line-height: 1.8; }
  dl { margin: 1.5rem 0; border-top: 1px solid rgba(245,240,232,.16); }
  dl div { display: flex; justify-content: space-between; padding: .6rem 0; border-bottom: 1px solid rgba(245,240,232,.12); font-size: .65rem; } dt { color: #aaa196; } dd { margin: 0; text-align: right; }
  .card a { color: #e3c98e; font-size: .66rem; letter-spacing: .1em; text-decoration: none; } .card a:hover { color: #fff; }
  footer { display: flex; justify-content: space-between; gap: 2rem; padding: 2rem 6vw; border-top: 1px solid rgba(245,240,232,.16); color: #aaa196; font-size: .7rem; letter-spacing: .1em; }
  .category-link{ display:inline-block; margin-top:1rem; color:#e3c98e; text-decoration:none; }
  .category-link:hover{ color:#fff; }
  @media (max-width: 720px) { main { padding-top: 5rem; } .intro { min-height: 52vh; } .statement { margin: 5rem 0 7rem; } .lineup-heading { display: block; } .lineup-heading span { display: block; margin-top: 1.5rem; } .grid { grid-template-columns: 1fr; gap: 4rem; } footer { display: block; } footer span + span { display: block; margin-top: .6rem; } }
</style>
