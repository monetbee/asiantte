---
const title = "Asiantte — Asian Beauty, Unapologetically.";
const description =
  "Asiantte celebrates every expression of Asian beauty.";
---

<!doctype html>

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Manrope:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="site-header">
      <a href="/" class="wordmark">Asiantte</a>
      <div class="menu-area">
        <button class="menu-toggle" type="button" aria-label="メニューを開く" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
        <nav class="menu-panel" aria-label="サイトメニュー">
          <a href="/about" data-detail="Asiantteの世界観と、ブランドが大切にする美しさについて">About</a>
          <a href="#collection" data-detail="The First Collection — 身につける人の存在感を引き立てるジュエリー">Collection</a>
          <a href="#founding-access" data-detail="First Collectionの先行情報と予約開始のお知らせを受け取る">Founding Access</a>
          <a href="#contact" data-detail="Asiantteへのお問い合わせはこちら">Contact</a>
          <a href="#collection" data-detail="大切な人に贈る、Asiantteのジュエリー">ギフト</a>
          <a href="#collection" data-detail="静かな存在感を添えるリング">リング</a>
          <a href="#collection" data-detail="The Drop — A mark of presence.">ピアス</a>
          <a href="#collection" data-detail="自分のリズムで揺れるブレスレット">ブレスレット</a>
          <a href="#collection" data-detail="首元に美しい余白をつくるネックレス">ネックレス</a>
          <a href="#collection" data-detail="ジュエリーをカテゴリーから探す">カテゴリー</a>
          <a href="#collection" data-detail="最新のコレクションと新着アイテム">新作</a>
        </nav>
        <div class="menu-detail" aria-live="polite">カーソルを合わせてください</div>
      </div>
    </header>

    <main>

	<section class="hero">
		<video
		class="hero-video"
		autoplay
		muted
		loop
		playsinline
		preload="metadata"
		aria-hidden="true"
		>
		<source
			src="https://pub-4488d6143e2b48f9991c039e0be1fa5a.r2.dev/asiantte-hero_compressed.mp4"
			type="video/mp4"
		/>
		</video>

		<div class="hero-overlay"></div>

		<div class="hero-content">
			<p class="eyebrow">ASIANTTE</p>
			<h1>Asian Beauty,<br />Unapologetically.</h1>
			<p class="japanese">自分の美しさを、自分で選ぶ。</p>
			<a href="#founding-access" class="button">Join Founding Access</a>
		</div>
	</section>

      <section class="belief">
        <p class="eyebrow">OUR BELIEF</p>
        <h2>自分の美しさを、</h2>
		<h2>自分で選ぶ。</h2>
        <p>
          Asiantteは、すべてのアジアの美しさを讃える、手の届くラグジュアリージュエリーブランドです。
        </p>
      </section>

      <section id="collection" class="collection">
        <p class="eyebrow">THE FIRST COLLECTION</p>
        <h2>Coming Soon</h2>

        <div class="collection-grid">
          <article class="product-card product-drop">
            <img
              src="/images/products/ "
              alt="Asiantte The Drop earrings"
              loading="lazy"
            />
            <div class="product-card-content">
              <span>01</span>
              <h3>The Drop</h3>
              <p>A mark of presence.</p>
            </div>
          </article>

          <article class="product-card product-wave">
            <img
              src="/images/products/ "
              alt="Asiantte The Wave earrings"
              loading="lazy"
            />
            <div class="product-card-content">
              <span>02</span>
              <h3>The Wave</h3>
              <p>Move with your own rhythm.</p>
            </div>
          </article>
        </div>
      </section>

      <section id="founding-access" class="founding-access">
        <p class="eyebrow">FOUNDING ACCESS</p>
        <h2>Be there from the beginning.</h2>
        <p>
          First Collectionの先行情報と予約開始のお知らせを受け取る。
        </p>

        <form>
          <input
            type="email"
            name="email"
            placeholder="Your email address"
            required
          />
          <button type="submit">Join</button>
        </form>
      </section>
    </main>

    <footer id="contact">
      <span>Asiantte</span>
      <span>Asian Beauty, Unapologetically.</span>
    </footer>
  </body>
</html>

<script>
  const menuDetail = document.querySelector('.menu-detail');
  const menuLinks = document.querySelectorAll('.menu-panel a');

  menuLinks.forEach((link) => {
    link.addEventListener('mouseenter', () => {
      menuDetail.textContent = link.dataset.detail || '';
    });

    link.addEventListener('focus', () => {
      menuDetail.textContent = link.dataset.detail || '';
    });
  });
  const menuToggle = document.querySelector('.menu-toggle');
  const menuArea = document.querySelector('.menu-area');

  menuToggle?.addEventListener('click', () => {
    const isOpen = menuArea?.classList.toggle('menu-open') ?? false;
    menuToggle.setAttribute('aria-expanded', String(isOpen));
  });
</script>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #111111;
    color: #f4efe8;
    font-family: "Manrope", "Noto Sans JP", sans-serif;
  }

  :global(a) {
    color: inherit;
  }

  .site-header {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 0;
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2rem 5vw;
  }

  .wordmark {
    font-family: "Cormorant Garamond", serif;
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  .menu-area {
    position: relative;
    width: min(68rem, 78vw);
    margin-top: 2.7rem;
  }

  .menu-toggle {
    display: none;
  }

  .menu-panel {
    display: flex;
    flex-wrap: nowrap;
    justify-content: flex-end;
    align-items: center;
    gap: clamp(0.55rem, 1.15vw, 1.4rem);
    white-space: nowrap;
  }

  .menu-panel a {
    position: relative;
    color: #f4efe8;
    font-family: "Manrope", "Noto Sans JP", sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .menu-panel a::after {
    position: absolute;
    right: 0;
    bottom: -0.25rem;
    left: 0;
    height: 1px;
    background: #b08d57;
    content: "";
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 180ms ease;
  }

  .menu-panel a:hover,
  .menu-panel a:focus-visible {
    color: #b08d57;
  }

  .menu-panel a:hover::after,
  .menu-panel a:focus-visible::after {
    transform: scaleX(1);
  }

  .menu-detail {
    min-height: 1.5rem;
    margin-top: 0.85rem;
    color: rgba(216, 212, 206, 0.72);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-align: right;
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .menu-panel a:hover + .menu-detail {
    opacity: 1;
  }

  .menu-area:has(.menu-panel a:hover) .menu-detail {
    opacity: 1;
  }

  .menu-detail::before {
    content: "";
  }

  @media (max-width: 900px) {
    .site-header {
      align-items: center;
    }

    .menu-area {
      width: auto;
      margin-top: 0;
    }

    .menu-toggle {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      gap: 4px;
      width: 2rem;
      height: 1.15vwemvwrem;
      padding: 0;
      border: 0;
      background: transparent;
      color: #f4efe8;
      cursor: pointer;
    }

    .menu-toggle span {
      display: block;
      width: 100%;
      height: 1px;
      background: currentColor;
      transition: transform 180ms ease, opacity 180ms ease;
    }

    .menu-panel {
      position: absolute;
      top: 2.6rem;
      right: 0;
      display: grid;
      grid-template-columns: repeat(2, minmax(8rem, 1fr));
      justify-content: initial;
      gap: 0.8rem 1.5rem;
      width: min(22rem, calc(100vw - 3rem));
      padding: 1.4rem;
      border: 1px solid rgba(216, 212, 206, 0.3);
      background: rgba(17, 17, 17, 0.97);
      box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.35);
      opacity: 0;
      pointer-events: none;
      transform: translateY(-0.5rem);
      transition: opacity 180ms ease, transform 180ms ease;
    }

    .menu-detail {
      position: absolute;
      top: calc(100% + 15rem);
      right: 0;
      width: min(22rem, calc(100vw - 3rem));
      margin: 0;
      text-align: right;
    }

    .menu-area:hover .menu-panel,
    .menu-area:focus-within .menu-panel,
    .menu-area.menu-open .menu-panel {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }
  }

  .hero,
  .belief,
  .collection,
  .founding-access {
    min-height: 85vh;
    padding: 9rem 10vw;
    display: grid;
    align-content: center;
  }

  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    overflow: hidden;
    background: #111111;
  }

  .hero-video,
  .hero-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-video {
    z-index: -3;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.7) contrast(1.05);
  }

  .hero-overlay {
    z-index: -2;
    background:
      linear-gradient(
        90deg,
        rgba(17, 17, 17, 0.82) 0%,
        rgba(17, 17, 17, 0.48) 55%,
        rgba(17, 17, 17, 0.7) 100%
      ),
      linear-gradient(
        0deg,
        rgba(17, 17, 17, 0.58),
        transparent 55%,
        rgba(17, 17, 17, 0.32)
      );
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    margin: 0 0 1.5rem;
    color: #b08d57;
    font-size: 0.7rem;
    letter-spacing: 0.24em;
  }

  h1,
  h2,
  h3 {
    font-family: "Cormorant Garamond", serif;
    font-weight: 600;
  }

  h1 {
    max-width: 950px;
    margin: 0;
    font-size: clamp(4rem, 10vw, 9rem);
    line-height: 0.88;
    letter-spacing: -0.045em;
  }

  h2 {
    max-width: 850px;
    margin: 0 0 2rem;
    font-size: clamp(2.8rem, 6vw, 6rem);
    line-height: 0.95;
  }

  h3 {
    margin: 1rem 0 0.5rem;
    font-size: clamp(2rem, 4vw, 3.5rem);
  }

  p {
    max-width: 620px;
    color: #d8d4ce;
    line-height: 1.8;
  }

  .japanese {
    margin-top: 2rem;
    font-size: 1.1rem;
  }

  .button,
  button {
    width: fit-content;
    margin-top: 2rem;
    padding: 1rem 1.4rem;
    border: 1px solid #b08d57;
    background: transparent;
    color: #f4efe8;
    font: inherit;
    text-decoration: none;
    cursor: pointer;
    transition:
      background 180ms ease,
      color 180ms ease;
  }

  .button:hover,
  button:hover {
    background: #b08d57;
    color: #111111;
  }

  .belief {
    background: #f4efe8;
    color: #111111;
  }

  .belief p {
    color: #4f4a45;
  }

  .belief .eyebrow {
    color: #6e1f2a;
  }

  .collection-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    max-width: 900px;
  }

  .collection-grid article {
    position: relative;
    min-height: 25rem;
    overflow: hidden;
    border: 1px solid rgba(176, 141, 87, 0.55);
    isolation: isolate;
  }

  .product-card img {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.8) contrast(1.05);
    transition: transform 500ms ease;
  }

  .product-card::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(180deg, rgba(17, 17, 17, 0.12) 15%, rgba(17, 17, 17, 0.82) 100%);
    content: "";
  }

  .product-card:hover img {
    transform: scale(1.04);
  }

  .product-card-content {
    position: absolute;
    inset: auto 2rem 2rem;
  }

  .product-card p,
  .product-card h3 {
    color: #f4efe8;
  }

  .collection-grid span {
    color: #b08d57;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
  }

  .founding-access {
    min-height: 75vh;
  }

  form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    max-width: 600px;
  }

  input {
    min-width: min(100%, 20rem);
    padding: 1rem;
    border: 1px solid #d8d4ce;
    background: transparent;
    color: #f4efe8;
    font: inherit;
  }

  input::placeholder {
    color: #d8d4ce;
  }

  form button {
    margin-top: 0;
  }

  footer {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding: 2rem 5vw;
    border-top: 1px solid rgba(216, 212, 206, 0.2);
    color: #d8d4ce;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }

    .hero {
      background: #111111;
    }
  }

  @media (max-width: 700px) {
    .site-header {
      padding: 1.5rem 6vw;
    }

    .menu-panel {
      grid-template-columns: 1fr;
      width: min(15rem, calc(100vw - 2rem));
    }

    .menu-detail {
      top: calc(100% + 23rem);
      width: min(15rem, calc(100vw - 2rem));
    }

    .menu-panel a {
      font-size: 0.65rem;
    }

    .hero,
    .belief,
    .collection,
    .founding-access {
      padding: 7rem 7vw;
    }

    .collection-grid {
      grid-template-columns: 1fr;
    }

    .collection-grid article {
      min-height: 22rem;
    }

    footer {
      flex-direction: column;
    }
  }
</style>