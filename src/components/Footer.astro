<style>
  .site-footer{background:linear-gradient(var(--gray-gradient));color:rgb(var(--gray));padding:3rem 6vw 4rem}
  .footer-top{display:grid;grid-template-columns:repeat(4,1fr);gap:2rem;margin-bottom:1.5rem}
  .footer-col h4{margin:0 0 .5rem;font-size:.95rem}
  .footer-col ul{list-style:none;padding:0;margin:0}
  .footer-col li{margin:.35rem 0}
  .footer-col a{color:inherit;text-decoration:none}
  .footer-col a:hover{text-decoration:underline}
  .footer-mid{display:flex;gap:2rem;justify-content:space-between;flex-wrap:wrap;margin-bottom:1.5rem}
  .footer-mid h4{margin:0 0 .5rem}
  .footer-mid ul{list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:.6rem}
  .footer-bottom{display:flex;flex-direction:column;align-items:center;gap:.5rem}
  .cta-links{display:flex;gap:1rem}
  .cta-links a{background:transparent;border:1px solid rgba(255,255,255,.06);padding:.45rem .75rem;border-radius:4px;color:inherit;text-decoration:none}
  @media (max-width:900px){.footer-top{grid-template-columns:repeat(2,1fr)}.footer-mid{flex-direction:column}}
  @media (max-width:520px){.footer-top{grid-template-columns:1fr}.cta-links{flex-direction:column}}
</style>
