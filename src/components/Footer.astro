<style>
	.site-footer {
		background: transparent;
		color: inherit;
		padding: 3rem 6vw 4rem;
		font-family: "Manrope", "Noto Sans JP", sans-serif;
		font-size: 16px;
		line-height: 1.6;
		letter-spacing: 0.02em;
	}
	.site-footer *,
	.site-footer *::before,
	.site-footer *::after {
		box-sizing: border-box;
	}
	.site-footer h4 {
		margin: 0 0 .5rem;
		padding: 0;
		font-family: inherit;
		font-size: .95rem;
		font-weight: 600;
		letter-spacing: .04em;
		color: inherit;
		line-height: 1.4;
	}
	.site-footer p {
		margin: 0;
		padding: 0;
		max-width: none;
		color: inherit;
		font-size: .82rem;
		line-height: 1.6;
	}
	.site-footer ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.site-footer li {
		margin: .35rem 0;
		padding: 0;
	}
	.site-footer a {
		color: inherit;
		text-decoration: none;
		font-family: inherit;
		font-size: .82rem;
		line-height: 1.6;
		letter-spacing: .02em;
	}
	.site-footer a:hover {
		text-decoration: underline;
	}
	.footer-top {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 2rem;
		margin-bottom: 1.5rem;
	}
	.footer-mid {
		display: flex;
		gap: 2rem;
		justify-content: space-between;
		flex-wrap: wrap;
		margin-bottom: 1.5rem;
	}
	.footer-mid h4 {
		margin: 0 0 .5rem;
	}
	.footer-mid ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: .6rem;
	}
	.social-links {
		gap: .8rem;
	}
	.social-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		padding: 0;
		border-radius: 50%;
		transition: opacity .2s, transform .2s;
		color: inherit;
	}
	.social-link:hover {
		opacity: .7;
		transform: scale(1.1);
	}
	.social-link svg {
		display: block;
		width: 20px;
		height: 20px;
	}
	.footer-bottom {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: .5rem;
	}
	.cta-links {
		display: flex;
		gap: 1rem;
	}
	.cta-links a {
		background: transparent;
		border: 1px solid currentColor;
		padding: .45rem .75rem;
		border-radius: 4px;
		color: inherit;
		text-decoration: none;
		font-size: .82rem;
		line-height: 1.6;
	}
	@media (max-width: 900px) {
		.footer-top { grid-template-columns: repeat(2, 1fr); }
		.footer-mid { flex-direction: column; }
	}
	@media (max-width: 520px) {
		.footer-top { grid-template-columns: 1fr; }
		.cta-links { flex-direction: column; }
	}
</style>