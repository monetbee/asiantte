<header class="site-header">
  <a href="/" class="wordmark">Asiantte</a>
  <div class="menu-area">
    <div class="lang-toggle" data-lang-toggle>
      <button type="button" data-lang-option="ja">JP</button>
      <button type="button" data-lang-option="en">EN</button>
    </div>
    <button class="menu-toggle" type="button" aria-label="メニューを開く" data-i18n-aria="nav.menuOpen" aria-expanded="false"><span></span><span></span><span></span></button>
    <nav class="menu-panel" aria-label="サイトメニュー">
      <a href="/about" data-i18n="nav.about" data-i18n-detail="nav.about.detail" data-detail="Asiantteの世界観と、ブランドが大切にする美しさ">About</a><a href="/collection" data-i18n="nav.collection" data-i18n-detail="nav.collection.detail" data-detail="2026年秋の二つのコレクションと全20製品">Collection</a><a href="/founding-access" data-i18n="nav.founding" data-i18n-detail="nav.founding.detail" data-detail="先行情報と予約開始のお知らせ">Founding Access</a><a href="/contact" data-i18n="nav.contact" data-i18n-detail="nav.contact.detail" data-detail="Asiantteへのお問い合わせ">Contact</a>
      <a href="/categories/gift" data-i18n="nav.gift" data-i18n-detail="nav.gift.detail" data-detail="大切な人へ贈る、記憶に残るジュエリー">ギフト</a><a href="/categories/rings" data-i18n="nav.rings" data-i18n-detail="nav.rings.detail" data-detail="手元に静かな存在感を添えるリング">リング</a><a href="/categories/earrings" data-i18n="nav.earrings" data-i18n-detail="nav.earrings.detail" data-detail="光を受け、表情を引き立てるピアス">ピアス</a><a href="/categories/bracelets" data-i18n="nav.bracelets" data-i18n-detail="nav.bracelets.detail" data-detail="所作に寄り添い、やわらかく揺れるブレスレット">ブレスレット</a><a href="/categories/necklaces" data-i18n="nav.necklaces" data-i18n-detail="nav.necklaces.detail" data-detail="首元に美しい余白をつくるネックレス">ネックレス</a><a href="/categories" data-i18n="nav.categories" data-i18n-detail="nav.categories.detail" data-detail="ジュエリーをカテゴリーから探す">カテゴリー</a><a href="/new-arrivals" data-i18n="nav.new" data-i18n-detail="nav.new.detail" data-detail="最新のコレクションと新着アイテム">新作</a><a href="/fine-jewelry" data-i18n="nav.fineJewelry" data-i18n-detail="nav.fineJewelry.detail" data-detail="職人の技術と素材にこだわったジュエリー">ファインジュエリー</a>
      <div class="menu-detail" aria-live="polite"></div>
    </nav>
  </div>
</header>
<script>
  import { initLangSwitcher } from '../i18n/lang';

  initLangSwitcher();

  const menuToggle = document.querySelector('.menu-toggle');
  const menuArea = document.querySelector('.menu-area');
  const menuDetail = document.querySelector<HTMLElement>('.menu-detail');
  const menuLinks = document.querySelectorAll<HTMLAnchorElement>('.menu-panel a');

  menuLinks.forEach((link) => {
    const showDetail = () => {
      if (!menuDetail) return;
      menuDetail.textContent = link.dataset.detail || '';
      menuDetail.style.top = `${link.offsetTop}px`;
      menuDetail.classList.add('is-visible');
    };
    link.addEventListener('pointerenter', showDetail);
    link.addEventListener('focus', showDetail);
  });

  menuArea?.addEventListener('pointerleave', () => menuDetail?.classList.remove('is-visible'));
  menuToggle?.addEventListener('click', () => {
    const isPinned = menuArea?.classList.contains('menu-open') ?? false;
    menuArea?.classList.toggle('menu-open', !isPinned);
    menuArea?.classList.toggle('menu-dismissed', isPinned);
    menuToggle.setAttribute('aria-expanded', String(!isPinned));
  });

  menuArea?.addEventListener('pointerleave', () => {
    if (!menuArea.classList.contains('menu-open')) {
      menuArea.classList.remove('menu-dismissed');
    }
  });

  document.addEventListener('pointerdown', (event) => {
    if (event.target instanceof Node && !menuArea?.contains(event.target)) {
      menuArea?.classList.remove('menu-open', 'menu-dismissed');
      menuToggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
<style>
  /* Home と全ページで、ロゴとメニューボタンの基準位置を共通化する。 */
  .site-header {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: flex-start;
    gap: 4rem;
    padding: 0 6vw;
  }

  .wordmark {
    flex: 0 0 auto;
    min-width: 11rem;
    color: inherit;
    font: 600 2rem "Cormorant Garamond", serif;
    letter-spacing: .08em;
    text-decoration: none;
    transform: translateY(1rem);
  }

  .menu-area {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: .6rem;
    flex: 0 0 auto;
    min-width: 2rem;
    margin-top: 2.7rem;
    margin-left: auto;
  }

  .lang-toggle {
    display: flex;
    gap: .3rem;
  }

  .lang-toggle button {
    border: 1px solid currentColor;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: 600 .6rem Manrope, "Noto Sans JP", sans-serif;
    letter-spacing: .05em;
    padding: .15rem .55rem;
    opacity: .55;
    cursor: pointer;
    transition: opacity 150ms ease, background 150ms ease, color 150ms ease;
  }

  .lang-toggle button.is-active {
    background: var(--accent, #B08D57);
    border-color: var(--accent, #B08D57);
    color: #fff;
    opacity: 1;
  }

  .menu-panel {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(.4rem, 1vw, 1.1rem);
    white-space: nowrap;
    transform: translateY(-.9rem);
  }

  .menu-panel a {
    color: inherit;
    font: 500 .7rem Manrope, "Noto Sans JP", sans-serif;
    letter-spacing: .06em;
    text-decoration: none;
  }

  .menu-detail { display: none; }

  .menu-toggle { display: none; }

  @media (max-width: 1100px) {
    .menu-area {
      margin-top: 1rem;
      padding-bottom: 1.4rem;
      margin-bottom: -1.4rem;
    }

    .menu-toggle {
      display: flex;
      flex-direction: column;
      gap: 4px;
      width: 2rem;
      padding: 0;
      border: 0;
      background: transparent;
      color: inherit;
      cursor: pointer;
    }

    .menu-toggle span {
      width: 100%;
      height: 1px;
      background: currentColor;
    }

    .menu-panel {
      position: absolute;
      top: 100%;
      right: 0;
      display: grid;
      grid-template-columns: 1fr;
      gap: .8rem;
      width: max-content;
      min-width: 22rem;
      max-width: calc(100vw - 3rem);
      padding: 1.4rem;
      background: #111;
      color: #fff;
      visibility: hidden;
      opacity: 0;
      pointer-events: none;
      transform: translateY(.75rem);
      transition: opacity 260ms ease-out, transform 260ms ease-out, visibility 0s linear 260ms;
    }

    .menu-area.menu-open .menu-panel,
    .menu-area:not(.menu-dismissed):hover .menu-panel,
    .menu-area:not(.menu-dismissed):focus-within .menu-panel {
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
      transition-delay: 0s;
    }

    .menu-area.menu-open .menu-toggle,
    .menu-area:not(.menu-dismissed):hover .menu-toggle,
    .menu-area:not(.menu-dismissed):focus-within .menu-toggle {
      color: #b08d57;
    }

    .menu-detail {
      position: absolute;
      z-index: 1;
      left: 8.5rem;
      display: block;
      width: 12rem;
      color: rgba(244, 239, 232, .72);
      font-size: .62rem;
      letter-spacing: .04em;
      line-height: 1.6;
      opacity: 0;
      pointer-events: none;
      transform: translateX(-.25rem);
      transition: opacity 180ms ease, transform 180ms ease;
    }

    .menu-detail.is-visible {
      opacity: 1;
      transform: translateX(0);
    }

    .menu-panel a { width: max-content; }
  }

  @media (max-width: 650px) {
    .site-header { padding: 1.5rem 6vw; }
    .menu-panel { min-width: min(22rem, calc(100vw - 2rem)); }
  }
</style>
