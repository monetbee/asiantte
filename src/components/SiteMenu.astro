<header class="site-header">
  <a href="/" class="wordmark">Asiantte</a>
  <div class="menu-area">
    <button class="menu-toggle" type="button" aria-label="メニューを開く" aria-expanded="false"><span></span><span></span><span></span></button>
    <nav class="menu-panel" aria-label="サイトメニュー">
      <a href="/about">About</a><a href="/collection">Collection</a><a href="/founding-access">Founding Access</a><a href="/contact">Contact</a>
      <a href="/categories/gift">ギフト</a><a href="/categories/rings">リング</a><a href="/categories/earrings">ピアス</a><a href="/categories/bracelets">ブレスレット</a><a href="/categories/necklaces">ネックレス</a><a href="/categories">カテゴリー</a><a href="/new-arrivals">新作</a><a href="/fine-jewelry">ファインジュエリー</a>
    </nav>
  </div>
</header>
<script>
  const menuToggle = document.querySelector('.menu-toggle');
  const menuArea = document.querySelector('.menu-area');
  menuToggle?.addEventListener('click', () => {
    const isPinned = menuArea?.classList.contains('menu-open') ?? false;
    menuArea?.classList.toggle('menu-open', !isPinned);
    menuArea?.classList.toggle('menu-dismissed', isPinned);
    menuToggle.setAttribute('aria-expanded', String(!isPinned));
  });

  menuArea?.addEventListener('pointerleave', () => {
    if (!menuArea.classList.contains('menu-open')) {
      menuArea.classList.remove('menu-dismissed');
    }
  });

  document.addEventListener('pointerdown', (event) => {
    if (event.target instanceof Node && !menuArea?.contains(event.target)) {
      menuArea?.classList.remove('menu-open', 'menu-dismissed');
      menuToggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
<style>
  /* Home と全ページで、ロゴとメニューボタンの基準位置を共通化する。 */
  .site-header {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: flex-start;
    gap: 4rem;
    padding: 0 6vw;
  }

  .wordmark {
    flex: 0 0 auto;
    min-width: 11rem;
    color: inherit;
    font: 600 2rem "Cormorant Garamond", serif;
    letter-spacing: .08em;
    text-decoration: none;
    transform: translateY(1rem);
  }

  .menu-area {
    position: relative;
    flex: 0 0 auto;
    min-width: 2rem;
    margin-top: 2.7rem;
    margin-left: auto;
  }

  .menu-panel {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(.4rem, 1vw, 1.1rem);
    white-space: nowrap;
    transform: translateY(-.9rem);
  }

  .menu-panel a {
    color: inherit;
    font: 500 .7rem Manrope, "Noto Sans JP", sans-serif;
    letter-spacing: .06em;
    text-decoration: none;
  }

  .menu-toggle { display: none; }

  @media (max-width: 1100px) {
    .menu-area { margin-top: 1rem; }

    .menu-toggle {
      display: flex;
      flex-direction: column;
      gap: 4px;
      width: 2rem;
      padding: 0;
      border: 0;
      background: transparent;
      color: inherit;
      cursor: pointer;
    }

    .menu-toggle span {
      width: 100%;
      height: 1px;
      background: currentColor;
    }

    .menu-panel {
      position: absolute;
      top: 2.6rem;
      right: 0;
      display: grid;
      grid-template-columns: 1fr;
      gap: .8rem;
      width: max-content;
      min-width: 22rem;
      max-width: calc(100vw - 3rem);
      padding: 1.4rem;
      background: #111;
      color: #fff;
      visibility: hidden;
      opacity: 0;
      pointer-events: none;
      transform: translateY(.75rem);
      transition: opacity 260ms ease-out, transform 260ms ease-out, visibility 0s linear 260ms;
    }

    .menu-area.menu-open .menu-panel,
    .menu-area:not(.menu-dismissed):hover .menu-panel,
    .menu-area:not(.menu-dismissed):focus-within .menu-panel {
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
      transition-delay: 0s;
    }

    .menu-area.menu-open .menu-toggle,
    .menu-area:not(.menu-dismissed):hover .menu-toggle,
    .menu-area:not(.menu-dismissed):focus-within .menu-toggle {
      color: #b08d57;
    }

  }

  @media (max-width: 650px) {
    .site-header { padding: 1.5rem 6vw; }
    .menu-panel { min-width: min(22rem, calc(100vw - 2rem)); }
  }
</style>
