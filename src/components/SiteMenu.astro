<header class="site-header">
  <a href="/" class="wordmark">Asiantte</a>
  <div class="menu-area">
    <button class="menu-toggle" type="button" aria-label="メニューを開く" aria-expanded="false"><span></span><span></span><span></span></button>
    <nav class="menu-panel" aria-label="サイトメニュー">
      <a href="/about">About</a><a href="/collection">Collection</a><a href="/founding-access">Founding Access</a><a href="/contact">Contact</a>
      <a href="/categories/gift">ギフト</a><a href="/categories/rings">リング</a><a href="/categories/earrings">ピアス</a><a href="/categories/bracelets">ブレスレット</a><a href="/categories/necklaces">ネックレス</a><a href="/categories">カテゴリー</a><a href="/new-arrivals">新作</a><a href="/fine-jewelry">ファインジュエリー</a>
    </nav>
  </div>
</header>
<script>
  const menuToggle = document.querySelector('.menu-toggle');
  const menuArea = document.querySelector('.menu-area');
  menuToggle?.addEventListener('click', () => {
    const open = menuArea?.classList.toggle('menu-open') ?? false;
    menuToggle.setAttribute('aria-expanded', String(open));
  });
</script>
<style>
  .site-header{position:relative;z-index:10;display:flex;justify-content:space-between;align-items:flex-start;gap:4rem;padding:0 6vw}.wordmark{flex:0 0 auto;min-width:11rem;color:inherit;font:600 2rem "Cormorant Garamond",serif;letter-spacing:.08em;text-decoration:none;transform:translateY(-1rem)}.menu-area{margin-left:auto;min-width:0}.menu-panel{display:flex;align-items:center;justify-content:flex-end;gap:clamp(.4rem,1vw,1.1rem);white-space:nowrap}.menu-panel a{color:inherit;font:500 .7rem Manrope,"Noto Sans JP",sans-serif;letter-spacing:.06em;text-decoration:none}.menu-toggle{display:none}
  @media (max-width: 2200px){.menu-panel{display:none}.menu-toggle{display:flex;flex-direction:column;gap:4px;width:2rem;padding:0;border:0;background:transparent;color:inherit;cursor:pointer}.menu-toggle span{height:1px;width:100%;background:currentColor}.menu-open .menu-panel{position:absolute;top:4.5rem;right:6vw;display:grid;grid-template-columns:repeat(2,1fr);gap:.8rem 1.5rem;padding:1.4rem;background:#111;color:#fff;white-space:nowrap}.menu-open .menu-panel a{font-size:.75rem}}
  @media (max-width:650px){.menu-open .menu-panel{grid-template-columns:1fr;right:1rem}.site-header{padding:1.5rem 1rem}}
</style>
